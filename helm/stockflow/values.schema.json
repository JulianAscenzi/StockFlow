{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "imagePullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "existingSecret": {
      "type": "string",
      "minLength": 1
    },
    "backend": {
      "type": "object",
      "properties": {
        "resources": {
          "type": "object",
          "required": [
            "requests",
            "limits"
          ]
        },
        "image": {
          "type": "object",
          "required": [
            "repository",
            "tag"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^$|^sha256:[a-f0-9]{64}$"
            }
          }
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 31
        },
        "ports": {
          "type": "object",
          "properties": {
            "http": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "management": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "pdb": {
          "type": "object",
          "properties": {
            "minAvailable": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "startupProbe": {
          "type": "object",
          "required": [
            "httpGet",
            "periodSeconds",
            "timeoutSeconds",
            "failureThreshold"
          ]
        },
        "livenessProbe": {
          "type": "object",
          "required": [
            "httpGet",
            "periodSeconds",
            "timeoutSeconds",
            "failureThreshold"
          ]
        },
        "readinessProbe": {
          "type": "object",
          "required": [
            "httpGet",
            "periodSeconds",
            "timeoutSeconds",
            "failureThreshold"
          ]
        }
      }
    },
    "frontend": {
      "type": "object",
      "properties": {
        "resources": {
          "type": "object",
          "required": [
            "requests",
            "limits"
          ]
        },
        "image": {
          "type": "object",
          "required": [
            "repository",
            "tag"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^$|^sha256:[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "resources": {
          "type": "object",
          "required": [
            "requests",
            "limits"
          ]
        },
        "image": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "prometheus": {
      "type": "object",
      "properties": {
        "resources": {
          "type": "object",
          "required": [
            "requests",
            "limits"
          ]
        },
        "image": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "grafana": {
      "type": "object",
      "properties": {
        "resources": {
          "type": "object",
          "required": [
            "requests",
            "limits"
          ]
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "alertmanager": {
      "type": "object",
      "properties": {
        "resources": {
          "type": "object",
          "required": [
            "requests",
            "limits"
          ]
        },
        "image": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
