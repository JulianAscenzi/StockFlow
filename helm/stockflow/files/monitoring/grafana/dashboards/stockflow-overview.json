      "datasource": {
        "type": "prometheus",
        "uid": "stockflow-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(instance)(jvm_memory_used_bytes{job=\"stockflow\",area=\"heap\"})/sum by(instance)(jvm_memory_max_bytes{job=\"stockflow\",area=\"heap\"}>0)",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
