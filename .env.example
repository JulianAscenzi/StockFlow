# Local PostgreSQL database name used by StockFlow.
POSTGRES_DB=stockflow

# Local PostgreSQL development user.
POSTGRES_USER=stockflow

# Placeholder development password. Replace it in .env if needed; never commit .env.
POSTGRES_PASSWORD=stockflow_dev_password

# Host port mapped to PostgreSQL's container port 5432.
POSTGRES_PORT=5432

# Browser port for Docker Compose; published on loopback only.
FRONTEND_PORT=5173

# Compose uses the same switch for API authentication and the login screen.
APP_AUTH_ENABLED=true

# Optional: enable backend JSON logs locally; leave unset for readable logs.
# SPRING_PROFILES_ACTIVE=prod

# Initial administrator for local development. Change both values before a real deployment.
APP_ADMIN_EMAIL=admin@stockflow.local
APP_ADMIN_PASSWORD=una_clave_local_segura

# At least 32 random characters. Generate a distinct value for every deployed environment.
APP_JWT_SECRET=un_secreto_largo_y_aleatorio

# Local monitoring UI ports (loopback only).
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# Required: generate a unique password in .env, e.g. openssl rand -hex 24.
GRAFANA_ADMIN_PASSWORD=

# Local Alertmanager UI; no external receivers configured.
ALERTMANAGER_PORT=9093
